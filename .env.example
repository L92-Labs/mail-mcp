# Copy to .env (Docker / Node) or set as Worker secrets/vars. Everything is env — no volumes.

# pull      = read + organize (no SMTP needed)
# draft     = pull + save drafts to the Drafts folder (never sends)
# pull_push = draft + send / reply / forward
MAIL_MODE=pull_push

# Required for HTTP / Docker / Workers. Long random string; same value on the MCP portal side.
MCP_BEARER_TOKEN=change-me

# Transport for Node: stdio | http (Docker forces http)
MCP_TRANSPORT=stdio
PORT=8787

# --- Send safety ---
# Only these recipients may receive mail (to/cc/bcc). Empty = anyone.
# Entries: exact address, or domain (also matches subdomains). Drafts are not restricted.
SEND_ALLOWLIST=
# Copy sent mail to the Sent folder: auto (skip Gmail/Microsoft, they do it) | true | false
SAVE_SENT=auto

# --- Limits ---
# email_get body text cap (chars) and attachment content cap (bytes)
MAX_BODY_CHARS=20000
ATTACHMENT_MAX_BYTES=2000000
# Max HTTP request body (attachments arrive base64)
# MAX_REQUEST_BYTES=33554432

# --- Optional soft state (in-memory, per process; 0 = off) ---
CACHE_TTL_SECONDS=0
EVENTS_POLL_SECONDS=0

# --- Cloudflare Tunnel (docker compose --profile tunnel) ---
# TUNNEL_TOKEN=

# Optional path override for stdio MCP clients
# EMAIL_ENV_FILE=/absolute/path/to/.env

DEFAULT_EMAIL_ACCOUNT=work

# --- Option A: multi-account JSON (one line) ---
# Per account optional: default_from_name, sender_emails[], save_sent, sent_folder, drafts_folder
EMAIL_ACCOUNTS_JSON={"work":{"smtp":{"host":"smtp.example.com","port":587,"secure":false,"user":"you@example.com","password":"app-password"},"imap":{"host":"imap.example.com","port":993,"secure":true,"user":"you@example.com","password":"app-password"},"default_from_name":"You","sender_emails":["you@example.com"]}}

# --- Option B: single account (uncomment; omit EMAIL_ACCOUNTS_JSON) ---
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=you@example.com
# IMAP_PASS=app-password
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# DEFAULT_FROM_NAME=You
# SENDER_EMAILS=you@example.com,alias@example.com
# SENT_FOLDER=Sent
# DRAFTS_FOLDER=Drafts
