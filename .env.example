# Copy to .env (Docker / Node) or set as Worker secrets/vars.

# Mode: pull (IMAP only) | pull_push (IMAP + SMTP)
MAIL_MODE=pull_push

# Optional metadata cache (0 = off)
CACHE_TTL_SECONDS=0

# Poll interval for inbox event cursors (0 = off; Worker also uses Cron)
EVENTS_POLL_SECONDS=0

# Required for HTTP / Docker / Workers remote MCP
MCP_BEARER_TOKEN=change-me

# Transport for Node: stdio | http
MCP_TRANSPORT=stdio
PORT=8787

# Optional path override for MCP clients
# EMAIL_ENV_FILE=/absolute/path/to/.env

DEFAULT_EMAIL_ACCOUNT=work

# --- Option A: multi-account JSON ---
EMAIL_ACCOUNTS_JSON={"work":{"smtp":{"host":"smtp.example.com","port":587,"secure":false,"user":"you@example.com","password":"app-password"},"imap":{"host":"imap.example.com","port":993,"secure":true,"user":"you@example.com","password":"app-password"},"default_from_name":"You","sender_emails":["you@example.com"]}}

# --- Option B: single account (uncomment; omit EMAIL_ACCOUNTS_JSON) ---
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=you@example.com
# IMAP_PASS=app-password
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# DEFAULT_FROM_NAME=You
